<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the encrypted login token isn't portable between devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="greywire_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="greywire_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
